<Window x:Class="Hzip.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Ground}" FontFamily="{StaticResource UiFace}" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" Title="Hzip · 压缩文件管理器" Width="1240" Height="810" MinWidth="940" MinHeight="630" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- ============ sidebar ============ -->
  <Border Background="{StaticResource Sidebar}">
   <Grid Margin="20,26,20,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="6,0,0,0"><Image Source="Assets/Hzip.png" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Hzip 图标"/><TextBlock Text="Hzip" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="压缩文件管理器" Foreground="{StaticResource Muted}" FontSize="12" Margin="16,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,22,0,0">
     <Button Style="{StaticResource NavActive}" Click="Home_Click" AutomationProperties.AutomationId="HomeButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="归档工作台"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}" Click="Open_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="打开归档"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}" Click="Batch_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="批量解压"/></StackPanel></Button>
     <TextBlock Text="工具箱" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,26,0,10"/>
     <Button Style="{StaticResource Nav}" Click="Vault_Click" AutomationProperties.AutomationId="VaultButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="密码管理"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}" Click="Repair_Click" AutomationProperties.AutomationId="RepairButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="ZIP 修复"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}" Click="Recovery_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="密码恢复"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="3">
     <Button Style="{StaticResource Nav}" Click="Jobs_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="JobsLabel" Text="任务记录"/></StackPanel></Button>
     <Button Style="{StaticResource Nav}" Click="Settings_Click" AutomationProperties.AutomationId="SettingsButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="设置与集成"/></StackPanel></Button>
     <TextBlock Text="文件只在本机处理" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,20,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- ============ canvas ============ -->
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="34"/></Grid.RowDefinitions>

   <Border Background="Transparent">
    <Grid Margin="32,26,32,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="归档工作台" FontWeight="SemiBold" FontSize="22" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PageSubtitle" Text="打开、整理与打包你的文件" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource Soft}" Click="Open_Click" Margin="0,0,9,0" Padding="15,8" AutomationProperties.AutomationId="OpenArchiveButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8DA;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="打开归档"/></StackPanel></Button><Button Style="{StaticResource Primary}" Click="Create_Click" Padding="16,8" AutomationProperties.AutomationId="CreateArchiveButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="创建归档"/></StackPanel></Button></StackPanel>
    </Grid>
   </Border>

   <!-- ============ home ============ -->
   <ScrollViewer x:Name="HomePanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,8,32,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="24,30">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="把压缩包拖到这里" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="也可以拖入文件或文件夹，开始创建归档" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0"/>
        <TextBlock Text="ZIP · 7Z · RAR · TAR · ISO · 更多格式" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="28,0,0,0">
        <Button Content="选择压缩包" Style="{StaticResource Primary}" Click="Open_Click" Padding="22,10" HorizontalAlignment="Right" AutomationProperties.AutomationId="ChooseArchiveButton"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Row="1" Margin="0,30,0,12"><TextBlock Text="最近打开" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><Button Content="清空记录" Style="{StaticResource Tool}" HorizontalAlignment="Right" Click="ClearHistory_Click" FontSize="12" Padding="6,4"/></Grid>
     <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" MinHeight="96" Padding="0,6">
      <Grid><TextBlock x:Name="NoRecentLabel" Text="打开过的归档会显示在这里" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
       <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent" MouseDoubleClick="Recent_DoubleClick" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="RecentArchives">
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="24,0" Height="56"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Directory}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/></Grid></DataTemplate></ListBox.ItemTemplate>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemBase}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,1"/></Style></ListBox.ItemContainerStyle>
       </ListBox>
      </Grid>
     </Border>
    </Grid>
   </ScrollViewer>

   <!-- ============ archive ============ -->
   <Grid x:Name="ArchivePanel" Grid.Row="1" Visibility="Collapsed" Margin="32,10,32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#E9EEF1" CornerRadius="4" Padding="9,4" VerticalAlignment="Center"><TextBlock x:Name="FormatLabel" Text="ZIP" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12"/></Border><TextBlock x:Name="ArchiveMetrics" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Text=""/><Button Grid.Column="2" Style="{StaticResource Tool}" Click="CloseArchive_Click" Content="关闭归档" FontSize="12" Padding="8,4"/></Grid>

    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="7,6">
     <Grid><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Primary}" Click="Extract_Click" Margin="0,0,6,0" Padding="16,8" AutomationProperties.AutomationId="ExtractButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="解压到…"/></StackPanel></Button><Button x:Name="AddFilesButton" Content="添加文件" Style="{StaticResource Tool}" Click="Add_Click" AutomationProperties.AutomationId="AddFilesButton"/><Button Content="测试" Style="{StaticResource Tool}" Click="Test_Click" AutomationProperties.AutomationId="TestArchiveButton"/><Button Content="预览" Style="{StaticResource Tool}" Click="Preview_Click" AutomationProperties.AutomationId="PreviewButton"/><Button Content="更多 &#x2304;" Style="{StaticResource Tool}" Click="More_Click"><Button.ContextMenu><ContextMenu><MenuItem Header="添加文件夹…" Click="AddFolder_Click"/><MenuItem Header="重命名条目" Click="Rename_Click"/><MenuItem Header="删除选中条目" Click="Delete_Click"/><Separator/><MenuItem Header="计算归档 SHA-256" Click="Hash_Click"/><MenuItem Header="更改文件名编码…" Click="Encoding_Click"/><MenuItem Header="打开所在文件夹" Click="Reveal_Click"/></ContextMenu></Button.ContextMenu></Button></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource Tool}" Content="刷新" Click="Refresh_Click" ToolTip="F5"/></Grid>
    </Border>

    <Border Grid.Row="2" Background="#F4F7F9" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0" Padding="9,7">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions><Button x:Name="UpButton" Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="14" Style="{StaticResource Tool}" Click="Up_Click" Padding="8,6" ToolTip="上一级 / Alt+↑"/><TextBlock x:Name="Breadcrumb" Grid.Column="1" Text="归档根目录" VerticalAlignment="Center" Margin="8,0,15,0" FontSize="14" TextTrimming="CharacterEllipsis"/><Grid Grid.Column="2"><TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="29,5,9,5" MinHeight="30" AutomationProperties.AutomationId="SearchEntries"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SearchHint" Text="搜索归档中的文件" Margin="29,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False" FontSize="12"/></Grid></Grid>
    </Border>

    <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" ClipToBounds="True">
     <Grid><DataGrid x:Name="EntriesGrid" PreviewMouseLeftButtonDown="EntriesGrid_DragStart" PreviewMouseMove="EntriesGrid_DragMove" ToolTip="可将选中的文件或文件夹拖到桌面或资源管理器；较大条目需要先准备解压。" MouseDoubleClick="Entry_DoubleClick" SelectionChanged="Entry_SelectionChanged" AutomationProperties.AutomationId="ArchiveEntries">
      <DataGrid.Columns><DataGridTemplateColumn Header="名称" Width="*" MinWidth="220" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" TextOptions.TextFormattingMode="Ideal" Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding DisplaySize}" SortMemberPath="Size" Width="96" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}"/><DataGridTextColumn Header="压缩后" Binding="{Binding DisplayPackedSize}" SortMemberPath="PackedSize" Width="96" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="100" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}"/><DataGridTextColumn Header="修改时间" Binding="{Binding DisplayDate}" SortMemberPath="Modified" Width="164" HeaderStyle="{StaticResource NumericHeader}" ElementStyle="{StaticResource NumericCell}"/></DataGrid.Columns>
      <DataGrid.ContextMenu><ContextMenu><MenuItem Header="打开 / 预览" Click="Preview_Click"/><MenuItem Header="解压选中条目…" Click="ExtractSelected_Click"/><Separator/><MenuItem Header="重命名" Click="Rename_Click"/><MenuItem Header="删除" Click="Delete_Click"/><MenuItem Header="复制条目路径" Click="CopyPath_Click"/></ContextMenu></DataGrid.ContextMenu>
     </DataGrid><TextBlock x:Name="NoEntriesLabel" Text="此文件夹没有内容" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
    </Border>
   </Grid>

   <!-- ============ active job ============ -->
   <Border x:Name="ActiveJobPanel" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource Surface}" Padding="32,13">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ActiveJobTitle" Text="正在处理…" Foreground="{StaticResource Ink}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ActiveJobProgress" Margin="0,9,26,0" Foreground="{StaticResource Accent}" Background="#E1E8EC" BorderThickness="0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PauseActiveButton" Content="暂停" Style="{StaticResource Soft}" Click="PauseActive_Click" Padding="13,6" FontSize="12" Margin="0,0,8,0" AutomationProperties.AutomationId="PauseActiveJob" ToolTip="保持 Hzip 运行，暂停后可继续；退出程序会取消任务。"/><Button Content="取消任务" Style="{StaticResource Tool}" Click="CancelActive_Click" Padding="13,6" FontSize="12" AutomationProperties.AutomationId="CancelActiveJob"/></StackPanel></Grid>
   </Border>

   <!-- ============ status ============ -->
   <Border Grid.Row="3" Background="Transparent" Padding="32,0"><Grid><TextBlock x:Name="StatusLabel" Text="就绪" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="Hzip 0.5" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
